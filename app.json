{
  "expo": {
    "name": "Treso",
    "slug": "treso",
    "description": "Income, expenses, monthly bills and a budget: know what you have left, today and at the end of the month. Your data stays on your phone.",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "githubUrl": "https://github.com/lucien-loua/treso",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "treso",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#5856D6",
    "ios": {
      "bundleIdentifier": "com.lucienloua.treso",
      "buildNumber": "1",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": ["en", "fr"]
      }
    },
    "android": {
      "package": "com.lucienloua.treso",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5856D6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_APP_BADGE",
        "android.permission.WAKE_LOCK",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.android.launcher.permission.INSTALL_SHORTCUT",
        "com.android.launcher.permission.READ_SETTINGS",
        "com.android.launcher.permission.UNINSTALL_SHORTCUT",
        "com.android.launcher.permission.WRITE_SETTINGS",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "fr"]
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#5856D6",
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e975c3e0-6cf7-4a85-bbea-9dfe362afa74"
      }
    },
    "owner": "lucien-loua"
  }
}
